{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Form Filler API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "SignInResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "account": {
            "$ref": "#/components/schemas/Account"
          }
        },
        "required": ["token", "account"]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri"
          },
          "quota": {
            "type": "object",
            "properties": {
              "plan": {
                "type": "string",
                "enum": ["free", "pro"]
              },
              "used": {
                "type": "integer",
                "minimum": 0
              },
              "limit": {
                "type": "integer",
                "minimum": 0
              },
              "resetsAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": ["plan", "used", "limit", "resetsAt"]
          },
          "profileReady": {
            "type": "boolean"
          },
          "profileVersion": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["id", "email", "quota", "profileReady", "profileVersion"]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHENTICATED",
              "INVALID_TOKEN",
              "QUOTA_EXCEEDED",
              "RATE_LIMITED",
              "PROFILE_NOT_READY",
              "INVALID_REQUEST",
              "UPSTREAM_ERROR",
              "INTERNAL"
            ]
          },
          "message": {
            "type": "string"
          },
          "retryAfter": {
            "type": "integer",
            "minimum": 0
          },
          "quota": {
            "type": "object",
            "properties": {
              "used": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "resetsAt": {
                "type": "string"
              }
            },
            "required": ["used", "limit", "resetsAt"]
          }
        },
        "required": ["code", "message"]
      },
      "SignInRequest": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["accessToken"]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "identity": {
            "type": "object",
            "properties": {
              "fullName": {
                "type": "string"
              },
              "preferredName": {
                "type": "string"
              },
              "email": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [""]
                  },
                  {
                    "type": "string",
                    "format": "email"
                  }
                ]
              },
              "phone": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "links": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [""]
                    },
                    {
                      "type": "string",
                      "format": "uri"
                    }
                  ]
                },
                "default": {}
              },
              "workAuthorization": {
                "type": "string"
              },
              "pronouns": {
                "type": "string"
              }
            }
          },
          "custom": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {}
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": ["document", "link", "text", "image", "audio"]
                },
                "label": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": ["pending", "parsing", "ready", "failed"]
                },
                "error": {
                  "type": "string"
                },
                "extractedChars": {
                  "type": "integer",
                  "minimum": 0
                },
                "mediaType": {
                  "type": "string"
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "url": {
                  "type": "string"
                },
                "hasFile": {
                  "type": "boolean",
                  "default": false
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": ["id", "kind", "label", "status", "createdAt"]
            },
            "default": []
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        },
        "required": ["identity"]
      },
      "ProfilePatch": {
        "type": "object",
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "custom": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Identity": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "preferredName": {
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "enum": [""]
              },
              {
                "type": "string",
                "format": "email"
              }
            ]
          },
          "phone": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "links": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [""]
                },
                {
                  "type": "string",
                  "format": "uri"
                }
              ]
            },
            "default": {}
          },
          "workAuthorization": {
            "type": "string"
          },
          "pronouns": {
            "type": "string"
          }
        }
      },
      "AddSourceResponse": {
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": ["profile", "truncated"]
      },
      "TextSourceRequest": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": ["profile"]
      },
      "FillPlan": {
        "type": "object",
        "properties": {
          "fills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fieldId": {
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "default": ""
                },
                "value": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "tier": {
                  "anyOf": [
                    {
                      "type": "number",
                      "enum": [0]
                    },
                    {
                      "type": "number",
                      "enum": [1]
                    },
                    {
                      "type": "number",
                      "enum": [2]
                    },
                    {
                      "type": "number",
                      "enum": [3]
                    }
                  ]
                },
                "reasoning": {
                  "type": "string"
                },
                "inferred": {
                  "type": "boolean",
                  "default": false
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                }
              },
              "required": ["fieldId", "value", "confidence", "tier"]
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fieldId": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "no_matching_knowledge",
                    "already_filled",
                    "unsupported_kind",
                    "quota_exhausted",
                    "model_error"
                  ]
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": ["fieldId", "reason"]
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "inputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "cacheReadTokens": {
                "type": "integer",
                "minimum": 0
              },
              "cacheWriteTokens": {
                "type": "integer",
                "minimum": 0
              },
              "costMicroUsd": {
                "type": "integer",
                "minimum": 0
              },
              "latencyMs": {
                "type": "integer",
                "minimum": 0
              },
              "modelsUsed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "inputTokens",
              "outputTokens",
              "cacheReadTokens",
              "cacheWriteTokens",
              "costMicroUsd",
              "latencyMs",
              "modelsUsed"
            ]
          },
          "quotaRemaining": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["fills", "skipped", "usage", "quotaRemaining"]
      },
      "FillRequest": {
        "type": "object",
        "properties": {
          "form": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "format": "uri"
              },
              "path": {
                "type": "string",
                "default": "/"
              },
              "pageTitle": {
                "type": "string"
              },
              "adapter": {
                "type": "string"
              },
              "pageContext": {
                "type": "string",
                "maxLength": 4000
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "text",
                        "longtext",
                        "email",
                        "tel",
                        "url",
                        "number",
                        "date",
                        "select",
                        "radio",
                        "checkbox",
                        "multiselect",
                        "file"
                      ]
                    },
                    "label": {
                      "type": "string"
                    },
                    "hint": {
                      "type": "string"
                    },
                    "placeholder": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean",
                      "default": false
                    },
                    "maxLength": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          }
                        },
                        "required": ["value", "label"]
                      }
                    },
                    "autocomplete": {
                      "type": "string"
                    },
                    "section": {
                      "type": "string"
                    },
                    "currentValue": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "kind", "label"]
                },
                "minItems": 1,
                "maxItems": 300
              }
            },
            "required": ["origin", "adapter", "fields"]
          },
          "quality": {
            "type": "string",
            "enum": ["auto", "high"],
            "default": "auto"
          },
          "overwriteExisting": {
            "type": "boolean",
            "default": false
          }
        },
        "required": ["form"]
      },
      "FeedbackRequest": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "format": "uri"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 400
                },
                "section": {
                  "type": "string",
                  "maxLength": 200
                },
                "hint": {
                  "type": "string",
                  "maxLength": 400
                },
                "proposed": {
                  "type": "string",
                  "maxLength": 4000
                },
                "accepted": {
                  "type": "string",
                  "maxLength": 4000
                },
                "edited": {
                  "type": "boolean"
                },
                "confirmed": {
                  "type": "boolean"
                }
              },
              "required": ["label", "accepted", "edited"]
            },
            "maxItems": 25
          }
        },
        "required": ["origin", "entries"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/auth/google": {
      "post": {
        "tags": ["auth"],
        "summary": "Exchange a Google access token for a session token",
        "operationId": "signInWithGoogle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "402": {
            "description": "Monthly quota exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": ["account"],
        "summary": "Current account, plan, and quota",
        "operationId": "getAccount",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "400": {
            "description": "Request failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "402": {
            "description": "Monthly quota exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profile": {
      "get": {
        "tags": ["profile"],
        "summary": "The full profile, including sources",
        "operationId": "getProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "description": "Request failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "402": {
            "description": "Monthly quota exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["profile"],
        "summary": "Edit structured profile fields",
        "description": "Identity is merged field by field; array fields are replaced wholesale. Send an empty string to clear an identity field.",
        "operationId": "patchProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "description": "Request failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "402": {
            "description": "Monthly quota exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profile/sources": {
      "post": {
        "tags": ["profile"],
        "summary": "Add a source from a URL or pasted text",
        "operationId": "addTextSource",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextSourceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Source added and profile recompiled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddSourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "402": {
            "description": "Monthly quota exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profile/sources/upload": {
      "post": {
        "tags": ["profile"],
        "summary": "Upload a file of any kind memory can read",
        "operationId": "uploadSource",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": ["file", "label"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Source added and profile recompiled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddSourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "402": {
            "description": "Monthly quota exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
