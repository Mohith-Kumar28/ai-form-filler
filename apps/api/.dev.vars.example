# Copy to `.dev.vars` (gitignored) for local `wrangler dev`.
# In production these are set with `wrangler secret put <NAME>`.

# OAuth 2.0 Client ID of type "Chrome Extension" from Google Cloud Console.
# Must match the `oauth2.client_id` in the extension manifest.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# HMAC key for our own session JWTs. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-me

# chrome-extension://<id> — find the id at chrome://extensions with dev mode on.
EXTENSION_ORIGIN=chrome-extension://replace-me

OPENROUTER_API_KEY=sk-or-v1-replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me

# Phase 6 only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
