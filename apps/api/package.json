{
  "name": "@aff/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:dry": "wrangler deploy --env production --dry-run",
    "tail": "wrangler tail --env production --format pretty",
    "tail:staging": "wrangler tail --env staging --format pretty",
    "cf:create": "node scripts/create-resources.mjs",
    "secrets:push": "node scripts/push-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply aff-db --local",
    "db:migrate:staging": "wrangler d1 migrations apply aff-db-staging --remote --env staging",
    "db:migrate:remote": "wrangler d1 migrations apply aff-db --remote --env production",
    "db:reset": "rm -rf .wrangler/state && wrangler d1 migrations apply aff-db --local",
    "db:query": "wrangler d1 execute aff-db --local --command",
    "db:costs": "node scripts/costs.mjs",
    "openapi:emit": "tsx scripts/emit-openapi.ts"
  },
  "dependencies": {
    "@aff/shared": "workspace:*",
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/google": "^4.0.43",
    "@hono/zod-openapi": "^1.5.2",
    "ai": "^7.0.64",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.5",
    "jose": "^6.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.23.12",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
