{
  "name": "@aff/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply aff-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply aff-db --remote",
    "openapi:emit": "tsx scripts/emit-openapi.ts"
  },
  "dependencies": {
    "@aff/shared": "workspace:*",
    "@hono/zod-openapi": "^1.5.2",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.64",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.5",
    "jose": "^6.1.0",
    "unpdf": "^1.8.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.23.12",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
