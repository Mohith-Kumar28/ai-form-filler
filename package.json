{
  "name": "ai-form-filler",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "//": "Single control point for the whole repo. `pnpm run` lists everything.",
    "//names": "NOTE: `deploy` and `doctor` are pnpm builtins and silently shadow a script of the same name — hence `ship` and `check:env`.",
    "//1-develop": "─────────────── develop ───────────────",
    "dev": "pnpm db:migrate && pnpm --parallel --filter \"./apps/*\" run dev",
    "dev:api": "pnpm db:migrate && pnpm --filter @aff/api run dev",
    "dev:ext": "pnpm --filter @aff/extension run dev",
    "dev:ext:firefox": "pnpm --filter @aff/extension run dev:firefox",
    "//2-build": "─────────────── build ───────────────",
    "build": "pnpm build:api && pnpm build:ext",
    "build:api": "pnpm --filter @aff/api run build",
    "build:ext": "pnpm --filter @aff/extension run build",
    "zip": "pnpm --filter @aff/extension run zip",
    "ext:reveal": "node scripts/reveal-extension.mjs",
    "//3-ship": "─────────────── ship ───────────────",
    "ship": "pnpm check && pnpm db:migrate:prod && pnpm --filter @aff/api run deploy",
    "ship:staging": "pnpm check && pnpm db:migrate:staging && pnpm --filter @aff/api run deploy:staging",
    "ship:dry": "pnpm --filter @aff/api run deploy:dry",
    "tail": "pnpm --filter @aff/api run tail",
    "tail:staging": "pnpm --filter @aff/api run tail:staging",
    "//4-setup": "─────────────── first-run setup ───────────────",
    "bootstrap": "pnpm install && pnpm db:migrate && pnpm api:generate && pnpm check:env",
    "check:env": "node scripts/setup-check.mjs",
    "cf:create": "pnpm --filter @aff/api run cf:create",
    "secrets:list": "node scripts/secrets.mjs",
    "secrets:push": "pnpm --filter @aff/api run secrets:push",
    "//5-database": "─────────────── database ───────────────",
    "db:generate": "pnpm --filter @aff/api run db:generate",
    "db:migrate": "pnpm --filter @aff/api run db:migrate:local",
    "db:migrate:staging": "pnpm --filter @aff/api run db:migrate:staging",
    "db:migrate:prod": "pnpm --filter @aff/api run db:migrate:remote",
    "db:reset": "pnpm --filter @aff/api run db:reset",
    "db:query": "pnpm --filter @aff/api run db:query",
    "db:costs": "pnpm --filter @aff/api run db:costs",
    "db:migrate:learned": "pnpm --filter @aff/api exec node scripts/migrate-learned-to-memory.mjs",
    "//6-contract": "─────────────── contract and codegen ───────────────",
    "api:generate": "pnpm --filter @aff/extension run api:generate",
    "api:spec": "pnpm --filter @aff/api run openapi:emit",
    "//7-quality": "─────────────── quality gates ───────────────",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @aff/form-adapters exec vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "//8-clean": "─────────────── housekeeping ───────────────",
    "clean": "rm -rf apps/*/.output apps/*/.wxt apps/*/dist && echo 'cleaned build artifacts'",
    "clean:all": "pnpm clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/api/.wrangler && echo 'cleaned everything — run pnpm install'",
    "ext:path": "node -e \"console.log('Load unpacked ->', require('path').resolve('apps/extension/.output/chrome-mv3-dev'))\"",
    "dev:token": "pnpm --filter @aff/api run dev:token"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@dodopayments/opencode-plugin": "^0.5.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
